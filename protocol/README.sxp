(doc
  (title "YX Protocol Specification")
  (source-format markdown)
  (converted "2026-07-19")
  (para "This directory contains the **language-agnostic** YX protocol specification. It describes WHAT YX is — the wire format, security model, protocol layers, and testing requirements — independently of any implementation language.")
  (section
    (heading "Purpose")
    (para "Any language (Python, Swift, Rust, Go, ...) that implements YX must conform to these specifications. The specs do not prescribe implementation details; they prescribe observable behaviour and wire-format compatibility."))
  (section
    (heading "Structure")
    (code "protocol/specs/
├── technical/
│   ├── _BASE.sxp                     # Wire format invariants, encoding rules
│   ├── yx-protocol-spec.sxp          # Core protocol specification
│   └── default-values.sxp            # Cross-language default values
├── architecture/
│   ├── _BASE.sxp                     # Design principles and layering rules
│   ├── ybs-decisions.sxp             # Architecture Decision Records (ADRs)
│   ├── protocol-layers.sxp           # Three-layer architecture
│   ├── api-contracts.sxp             # Language-agnostic API contracts
│   ├── implementation-languages.sxp  # Language selection guidance
│   └── security-architecture.sxp    # Security model and threat mitigations
└── testing/
    ├── _BASE.sxp                     # Test coverage and compatibility standards
    ├── testing-strategy.sxp          # Testing requirements by category
    └── interoperability-requirements.sxp  # Mandatory 48-test interop matrix"))
  (section
    (heading "Build Systems That Implement This Protocol")
    (item "[`../python/`](../python/) — Python reference implementation")
    (item "[`../swift/`](../swift/) — Swift high-performance implementation"))
  (section
    (heading "Canonical Artifacts")
    (para "The canonical test vectors generated by the Python implementation live in [`../canonical/`](../canonical/) and serve as ground truth for all implementations.")))
