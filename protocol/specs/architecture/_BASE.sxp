(doc
  (title "Architecture Specifications — System-Wide Defaults")
  (source-format markdown)
  (converted "2026-07-19")
  (kv "System" "YX Protocol")
  (kv "Category" "Architecture")
  (kv "Type" "BASE (applies to all architecture specs in this category)")
  (kv "Version" "0.1.0")
  (kv "Last Updated" "2026-04-11")
  (section
    (heading "Design Principles")
    (para "These principles govern all architectural decisions in the YX protocol. Every ADR and architecture spec must be consistent with these principles.")
    (subsection
      (heading "P1 — Payload Agnostic")
      (para "The transport layer carries opaque bytes. It has no knowledge of payload semantics. Protocol layers above transport interpret payload content."))
    (subsection
      (heading "P2 — Security by Default")
      (para "Every packet is authenticated via HMAC. There is no unauthenticated mode. Replay protection and rate limiting are mandatory components, not optional."))
    (subsection
      (heading "P3 — Wire Format Stability")
      (para "The binary packet format is stable. Changes that break byte-level compatibility with existing implementations require an explicit ADR and version increment."))
    (subsection
      (heading "P4 — Multi-Language Parity")
      (para "All implementations in all languages must produce and consume identical wire formats. Feature parity is required: a capability defined in one implementation is a requirement for all others."))
    (subsection
      (heading "P5 — Separation of Concerns")
      (para "The three layers (Transport, Protocol 0 Text, Protocol 1 Binary) are independent. Higher layers depend on lower layers but not vice versa.")))
  (section
    (heading "Layering Constraints")
    (code "Protocol 1 (Binary)  ─┐
                       ├─ Transport Layer (UDP + HMAC)
Protocol 0 (Text)   ─┘")
    (item "Transport layer: packet framing, HMAC auth, GUID, UDP I/O")
    (item "Protocol 0: JSON/text payload routing")
    (item "Protocol 1: binary chunked payload with optional compression/encryption")
    (item "Layers do not bypass each other"))
  (section
    (heading "Decision Records")
    (para "All architectural decisions are recorded in `ybs-decisions.sxp` as ADRs (D01, D02...). New decisions must be documented there before implementation begins.")))
