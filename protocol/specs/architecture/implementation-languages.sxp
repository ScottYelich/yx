(doc
  (title "YX Implementation Languages")
  (source-format markdown)
  (converted "2026-07-19")
  (para "**Version:** 0.1.0 **Last Updated:** 2026-01-18")
  (section
    (heading "Overview")
    (para "This document specifies the programming languages supported for YX protocol implementations and provides guidance on language selection."))
  (section
    (heading "Reference Implementation")
    (para "The YX protocol was originally developed as part of the AlgoTrader system (`../sdts/scott/algotrader`).")
    (subsection
      (heading "Reference Implementation Language Distribution")
      (table
        (row "Language" "Files" "Percentage" "Purpose")
        (row "Python" "231" "93%" "Core framework, services, dashboard, algorithms")
        (row "Swift" "17" "7%" "High-performance services, algorithms")
        (row "Bash" "30+" "N/A" "Testing, deployment, system utilities"))
      (para "**Key Finding:** Python is the primary implementation language, with Swift used selectively for performance-critical components.")))
  (section
    (heading "Supported Implementation Languages")
    (subsection
      (heading "Tier 1: Primary Languages (Reference Implementations)")
      (subsection
        (heading "Python")
        (item "**Status:** Reference implementation exists")
        (item "**Location:** `../sdts/src/python/yx/`")
        (item "**Version:** Python 3.11+")
        (item "**Use Cases:**")
        (item "General-purpose YX applications")
        (item "Service frameworks")
        (item "Rapid prototyping")
        (item "Dashboard and UI applications")
        (item "**Advantages:**")
        (item "Comprehensive asyncio support")
        (item "Rich ecosystem (pytest, cryptography library)")
        (item "Fast development cycle")
        (item "Cross-platform")
        (item "**Package Requirements:**")
        (item "`cryptography` (HMAC, AES-256-GCM)")
        (item "`asyncio` (async/await support)"))
      (subsection
        (heading "Swift")
        (item "**Status:** Reference implementation exists")
        (item "**Location:** `../sdts/src/swift/yx/`")
        (item "**Version:** Swift 5.9+")
        (item "**Use Cases:**")
        (item "High-performance services")
        (item "Low-latency applications")
        (item "macOS/iOS native applications")
        (item "Memory-constrained environments")
        (item "**Advantages:**")
        (item "Native performance (compiled)")
        (item "Strong type safety")
        (item "Excellent async/await support")
        (item "Apple ecosystem integration")
        (item "**Package Requirements:**")
        (item "`CryptoKit` (HMAC, AES-GCM)")
        (item "Foundation (networking)")))
    (subsection
      (heading "Tier 2: Planned Languages (No Reference Implementation)")
      (subsection
        (heading "Rust")
        (item "**Status:** Planned, not yet implemented")
        (item "**Use Cases:**")
        (item "Ultra-low-latency applications")
        (item "Systems programming")
        (item "Embedded systems")
        (item "Security-critical applications")
        (item "**Advantages:**")
        (item "Memory safety without GC")
        (item "Zero-cost abstractions")
        (item "Fearless concurrency")
        (item "**Recommended Crates:**")
        (item "`tokio` (async runtime)")
        (item "`ring` or `rustcrypto` (cryptography)")
        (item "`serde` (serialization)"))
      (subsection
        (heading "Go")
        (item "**Status:** Planned, not yet implemented")
        (item "**Use Cases:**")
        (item "Microservices")
        (item "Cloud-native applications")
        (item "Concurrent systems")
        (item "**Advantages:**")
        (item "Built-in concurrency (goroutines)")
        (item "Fast compilation")
        (item "Excellent standard library")
        (item "Cross-compilation")
        (item "**Recommended Packages:**")
        (item "Standard library `crypto` (HMAC, AES-GCM)")
        (item "`encoding/json` (JSON handling)"))
      (subsection
        (heading "JavaScript/TypeScript")
        (item "**Status:** Planned, not yet implemented")
        (item "**Use Cases:**")
        (item "Web applications")
        (item "Node.js services")
        (item "Browser-based clients")
        (item "**Advantages:**")
        (item "Universal (browser + server)")
        (item "Large ecosystem")
        (item "TypeScript type safety")
        (item "**Recommended Packages:**")
        (item "`crypto` (Node.js crypto module)")
        (item "`dgram` (UDP sockets)"))
      (subsection
        (heading "C/C++")
        (item "**Status:** Planned, not yet implemented")
        (item "**Use Cases:**")
        (item "Embedded systems")
        (item "Legacy system integration")
        (item "Maximum performance")
        (item "**Advantages:**")
        (item "Direct hardware access")
        (item "Minimal overhead")
        (item "Legacy interop")
        (item "**Recommended Libraries:**")
        (item "OpenSSL (cryptography)")
        (item "libsodium (cryptography alternative)"))))
  (section
    (heading "Language Selection Guidelines")
    (subsection
      (heading "When to Use Python")
      (para "✅ **Choose Python when:**")
      (item "Development speed is priority")
      (item "Integration with Python ecosystem needed")
      (item "Prototyping or proof-of-concept")
      (item "Dashboard/UI applications")
      (item "Data processing workloads")
      (item "Team is Python-experienced")
      (para "❌ **Avoid Python when:**")
      (item "Ultra-low latency required (<1ms)")
      (item "Memory footprint critical (<50MB)")
      (item "CPU-intensive continuous processing"))
    (subsection
      (heading "When to Use Swift")
      (para "✅ **Choose Swift when:**")
      (item "Performance is critical")
      (item "macOS/iOS native app")
      (item "Low memory footprint needed")
      (item "Type safety is priority")
      (item "Apple ecosystem integration")
      (para "❌ **Avoid Swift when:**")
      (item "Cross-platform deployment (Linux/Windows)")
      (item "Team lacks Swift experience")
      (item "Rapid prototyping needed"))
    (subsection
      (heading "When to Use Rust (Future)")
      (para "✅ **Choose Rust when:**")
      (item "Maximum performance required")
      (item "Memory safety without GC critical")
      (item "Embedded/systems programming")
      (item "Security-critical applications")
      (para "❌ **Avoid Rust when:**")
      (item "Team lacks Rust experience")
      (item "Rapid development needed")
      (item "Simple use case (overkill)"))
    (subsection
      (heading "When to Use Go (Future)")
      (para "✅ **Choose Go when:**")
      (item "Microservices architecture")
      (item "Cloud-native deployment")
      (item "Concurrency-heavy workload")
      (item "Fast compilation needed")
      (para "❌ **Avoid Go when:**")
      (item "Complex type systems needed")
      (item "Generics required (limited support)")))
  (section
    (heading "Wire Format Compatibility")
    (para "**CRITICAL REQUIREMENT:** All language implementations MUST produce identical wire format.")
    (subsection
      (heading "Verification Process")
      (item "1. **Reference Packet Generation:**")
      (item "Use Python implementation to generate test packets")
      (item "Document exact byte sequences")
      (item "2. **New Implementation Validation:**")
      (item "Generate same logical message in new language")
      (item "Compare byte-for-byte with reference")
      (item "Verify HMAC matches")
      (item "Verify payload structure matches")
      (item "3. **Cross-Language Testing:**")
      (item "Python sender → New language receiver")
      (item "New language sender → Python receiver")
      (item "Verify message integrity and parsing"))
    (subsection
      (heading "Test Vector Example")
      (code "Message: {\"method\": \"test\", \"params\": {}}
Key: 32 bytes of 0x00
GUID: 0x010203040506

Expected Packet (hex):
HMAC:    [16 bytes - computed]
GUID:    01 02 03 04 05 06
Payload: 00 7B 22 6D 65 74 68 6F 64 22 3A 22 74 65 73 74 22 2C ...")))
  (section
    (heading "Performance Characteristics")
    (para "Based on reference implementation and language characteristics:")
    (table
      (row "Language" "Latency" "Throughput" "Memory" "Startup")
      (row "Python" "~1-5ms" "~10K msg/s" "~50-100MB" "~100ms")
      (row "Swift" "~0.1-1ms" "~50K msg/s" "~20-50MB" "~10ms")
      (row "Rust (est)" "~0.05-0.5ms" "~100K+ msg/s" "~5-20MB" "~1ms")
      (row "Go (est)" "~0.1-1ms" "~50K msg/s" "~20-50MB" "~10ms"))
    (para "*Note: Estimates based on typical language characteristics; actual performance depends on implementation quality.*"))
  (section
    (heading "Language-Specific Considerations")
    (subsection
      (heading "Python Considerations")
      (item "**Asyncio:** Use `asyncio` for non-blocking I/O")
      (item "**GIL:** Global Interpreter Lock limits CPU parallelism (not an issue for I/O-bound YX)")
      (item "**Type Hints:** Use type hints for better code quality (`typing` module)")
      (item "**Packaging:** Use `pyproject.toml` for modern Python packaging"))
    (subsection
      (heading "Swift Considerations")
      (item "**Async/Await:** Use Swift 5.5+ structured concurrency")
      (item "**Package Manager:** Use Swift Package Manager (SPM)")
      (item "**Platform:** macOS 12+ required for full async/await support")
      (item "**Linux Support:** Limited but improving (Swift on Linux)"))
    (subsection
      (heading "Future Language Considerations")
      (subsection
        (heading "Rust")
        (item "**Async Runtime:** Tokio is de facto standard")
        (item "**Error Handling:** Use `Result<T, E>` for all fallible operations")
        (item "**Memory Model:** Leverage ownership for zero-copy operations"))
      (subsection
        (heading "Go")
        (item "**Goroutines:** One goroutine per connection pattern")
        (item "**Context:** Use `context.Context` for cancellation")
        (item "**Error Handling:** Explicit error returns"))))
  (section
    (heading "Implementation Priority")
    (subsection
      (heading "Phase 1: Reference Implementations (Complete)")
      (item "✅ Python (complete)")
      (item "✅ Swift (complete)"))
    (subsection
      (heading "Phase 2: High-Priority Languages")
      (item "Rust (high performance, embedded)")
      (item "Go (cloud-native, microservices)"))
    (subsection
      (heading "Phase 3: Ecosystem Languages")
      (item "JavaScript/TypeScript (web/Node.js)")
      (item "C/C++ (embedded, legacy)"))
    (subsection
      (heading "Phase 4: Additional Languages (As Needed)")
      (item "Java/Kotlin (Android, enterprise)")
      (item "C# (Windows, Unity)")
      (item "Elixir (distributed systems)")))
  (section
    (heading "Porting Guidelines")
    (para "When implementing YX in a new language:")
    (item "1. **Start with Protocol Spec:** Read `../technical/yx-protocol-spec.sxp` thoroughly")
    (item "2. **Implement Core First:** Packet building/parsing before protocols")
    (item "3. **Test Incrementally:** Unit test each component")
    (item "4. **Verify Wire Format:** Compare with reference implementation")
    (item "5. **Add Protocol Support:** Text protocol, then Binary protocol")
    (item "6. **Test Interoperability:** Cross-language message exchange")
    (item "7. **Document Differences:** Any language-specific considerations")
    (subsection
      (heading "Reference Implementation as Guide")
      (item "**Study:** `../sdts/src/python/yx/` for Python patterns")
      (item "**Study:** `../sdts/src/swift/yx/` for Swift patterns")
      (item "**Compare:** See how each handles async, crypto, networking")
      (item "**Test Against:** Use existing tests as validation")))
  (section
    (heading "Summary")
    (para "YX is designed to be **language-agnostic at the protocol level** while providing **idiomatic implementations** in each supported language.")
    (para "**Current Status:**")
    (item "Python: Reference implementation, production-ready")
    (item "Swift: Reference implementation, production-ready")
    (item "Others: Planned, following wire format specification")
    (para "**Selection Criteria:**")
    (item "Python for general use, rapid development")
    (item "Swift for performance, Apple ecosystem")
    (item "Future languages for specific use cases")
    (para "All implementations must maintain **wire format compatibility** verified through cross-language testing.")))
