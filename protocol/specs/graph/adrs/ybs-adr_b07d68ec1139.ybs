(adr (id "b07d68ec1139") (version "1.0.0") (status 'approved) (for "36a232582d9d")
  (title "D11: S-expression is the canonical structured payload")
  (decision "Structured payloads are s-expr; car-dispatch; JSON only at external edges.")
  (rationale "Always-known parse state (paren depth = completeness); uniform nesting; ecosystem-native.")
  (source "protocol/specs/architecture/ybs-decisions.md#D11"))
