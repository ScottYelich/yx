(doc
  (title "YX UDP Protocol Specification")
  (source-format markdown)
  (converted "2026-07-19")
  (section
    (heading "Overview")
    (para "YX is a secure, payload-agnostic UDP-based networking protocol with HMAC integrity, optional encryption/compression, and chunked delivery for large messages.")
    (para "**Version:** 1.0.3 (Binary Protocol v2.0) **Transport:** UDP broadcast **Default Port:** 50000 **Languages:** Python, Swift (wire-format parity)"))
  (section
    (heading "Wire Format")
    (subsection
      (heading "Packet Structure (3 Layers)")
      (code "┌────────────────┬──────────────┬──────────────────────────────────┐
│  HMAC (16B)    │  GUID (6B)   │  Payload (variable)              │
└────────────────┴──────────────┴──────────────────────────────────┘
   0          16  17         22  23                              ...")
      (para "**Minimum packet size:** 22 bytes (16 HMAC + 6 GUID)"))
    (subsection
      (heading "Layer 1: HMAC (16 bytes, offset 0-15)")
      (item "**Algorithm:** HMAC-SHA256 truncated to 128 bits (16 bytes)")
      (item "**Input:** `GUID (6 bytes) + Payload (all remaining bytes)`")
      (item "**Key:** 32-byte shared symmetric key")
      (item "**Validation:** Constant-time comparison on receive")
      (item "**Purpose:** Packet integrity verification")
      (para "**Computation:**")
      (code "hmac_input = guid_6_bytes + payload_bytes
hmac_value = HMAC-SHA256(hmac_input, key)[0:16]  # Truncate to 16 bytes"))
    (subsection
      (heading "Layer 2: GUID (6 bytes, offset 16-21)")
      (item "**Purpose:** Sender identification")
      (item "**Format:** 6 random bytes from cryptographically secure RNG")
      (item "**Encoding:** Raw binary, no internal structure")
      (item "**Padding:** Zero-padded to exactly 6 bytes if source is shorter"))
    (subsection
      (heading "Layer 3: Payload (variable, offset 22+)")
      (item "**Format:** Protocol-agnostic binary data")
      (item "**Protocol Detection:** First byte determines protocol type")
      (item "`0x00-0x1F` = Binary protocol (first byte is Protocol ID)")
      (item "`0x20+` = Text protocol (typically ASCII/UTF-8)")))
  (section
    (heading "Protocol Versions")
    (subsection
      (heading "Protocol 0: Text Protocol")
      (para "**Characteristics:**")
      (item "**Protocol Marker:** First byte `0x00`")
      (item "**Format:** Plain UTF-8 encoded text (typically JSON)")
      (item "**Security:** HMAC integrity only (no encryption)")
      (item "**Compression:** None")
      (item "**Chunking:** Single packet delivery only")
      (item "**Use Case:** Simple text/JSON messages that fit in single UDP packet")
      (para "**Payload Structure:**")
      (code "┌──────┬────────────────────────────┐
│ 0x00 │  UTF-8 encoded text        │
└──────┴────────────────────────────┘
   0     1                        ..."))
    (subsection
      (heading "Protocol 1: Binary Protocol v2.0")
      (para "**Characteristics:**")
      (item "**Protocol Marker:** First byte `0x01`")
      (item "**Format:** Structured header + optional compression/encryption + chunking")
      (item "**Security:** HMAC + optional AES-256-GCM encryption")
      (item "**Compression:** Optional ZLIB compression")
      (item "**Chunking:** Supports multi-packet messages (default 1024 byte chunks)")
      (item "**Use Case:** Large messages, encrypted messages, high-throughput data")
      (para "**Header Structure (16 bytes):**")
      (code "┌──────┬──────────┬───────────┬──────────┬────────────┬─────────────┐
│proto │protoOpts │channelID  │sequence  │chunkIndex  │totalChunks  │
│ 1B   │   1B     │    2B     │   4B     │    4B      │     4B      │
└──────┴──────────┴───────────┴──────────┴────────────┴─────────────┘
   0      1          2-3        4-7        8-11         12-15")
      (para "**Field Descriptions:**")
      (table
        (row "Field" "Type" "Range" "Description")
        (row "`proto`" "uint8" "0x01" "Protocol version identifier")
        (row "`protoOpts`" "uint8" "0x00-0x03" "Bit flags for compression/encryption")
        (row "`channelID`" "uint16" "0-65535" "Logical channel for message isolation")
        (row "`sequence`" "uint32" "0-4294967295" "Per-channel message sequence number")
        (row "`chunkIndex`" "uint32" "0-N" "Current chunk index (0-based)")
        (row "`totalChunks`" "uint32" "1-N" "Total number of chunks for this message"))
      (para "**protoOpts Flags (1 byte):**")
      (table
        (row "Value" "Hex" "Compression" "Encryption" "Description")
        (row "0" "0x00" "No" "No" "Plaintext, uncompressed")
        (row "1" "0x01" "Yes" "No" "ZLIB compressed, plaintext")
        (row "2" "0x02" "No" "Yes" "Uncompressed, AES-256-GCM encrypted")
        (row "3" "0x03" "Yes" "Yes" "ZLIB compressed + AES-256-GCM encrypted"))
      (para "**Binary Protocol v2.0 Changes:**")
      (para "v1.0 used `msgID` (1 byte) for message identification. v2.0 replaced this with:")
      (item "`channelID` (2 bytes) - Allows 65,536 logical channels")
      (item "`sequence` (4 bytes) - Per-channel sequence numbers (4B range per channel)")
      (item "**Buffer Key:** `(channelID, sequence)` tuple instead of `GUID + msgID`")
      (item "**Benefit:** Better scalability for high-throughput applications")))
  (section
    (heading "Security Mechanisms")
    (subsection
      (heading "1. HMAC-SHA256 Integrity")
      (para "**Purpose:** Verify packet integrity and authenticity")
      (para "**Implementation:**")
      (code "def compute_hmac(data: bytes, key: bytes) -> bytes:
    h = hmac.HMAC(key, hashes.SHA256())
    h.update(data)
    return h.finalize()[:16]  # Truncate to 16 bytes")
      (para "**Properties:**")
      (item "32-byte symmetric key shared across all peers")
      (item "Computed over `GUID + Payload`")
      (item "Constant-time validation to prevent timing attacks")
      (item "Failed validations logged to `/tmp/hmac_failures.log` for forensics"))
    (subsection
      (heading "2. AES-256-GCM Encryption")
      (para "**Purpose:** Confidentiality and authenticity of payload data")
      (para "**Algorithm:** AES-256 in Galois/Counter Mode (GCM)")
      (para "**Implementation:**")
      (code "def encrypt_aes_gcm(plaintext: bytes, key: bytes) -> Tuple[bytes, bytes]:
    aesgcm = AESGCM(key)  # 32-byte key
    nonce = os.urandom(12)  # 96-bit random nonce
    ciphertext = aesgcm.encrypt(nonce, plaintext, None)
    return nonce, ciphertext  # ciphertext includes 16-byte auth tag")
      (para "**Properties:**")
      (item "**Key Size:** 256 bits (32 bytes)")
      (item "**Nonce:** 12 bytes, randomly generated per encryption")
      (item "**Authentication Tag:** 16 bytes (built into GCM mode)")
      (item "**Overhead:** 28 bytes per encrypted message (12 nonce + 16 tag)")
      (item "**Nonce Storage:** Prepended to ciphertext: `nonce(12) + ciphertext + tag(16)`")
      (para "**CRITICAL:** Applied to FULL reassembled message, not per-chunk"))
    (subsection
      (heading "3. ZLIB Compression")
      (para "**Purpose:** Reduce bandwidth for compressible payloads")
      (para "**Algorithm:** DEFLATE (RFC 1951)")
      (para "**Implementation:**")
      (code "def compress_data(data: bytes, level: int = 6) -> bytes:
    compressor = zlib.compressobj(level=level, wbits=-15)  # Raw DEFLATE
    return compressor.compress(data) + compressor.flush()

def decompress_data(compressed: bytes) -> bytes:
    return zlib.decompress(compressed, wbits=-15)")
      (para "**Properties:**")
      (item "**Mode:** Raw DEFLATE (no zlib wrapper, `wbits=-15`)")
      (item "**Level:** Default 6 (balanced speed/compression)")
      (item "**Order:** Always compress BEFORE encryption")
      (para "**CRITICAL:** Applied to FULL message before encryption and chunking"))
    (subsection
      (heading "4. Rate Limiting")
      (para "**Purpose:** Defense against packet flood DoS attacks")
      (para "**Algorithm:** Sliding window per peer")
      (para "**Implementation:**")
      (item "Tracks timestamps per peer: `Dict[peer_id, List[timestamp]]`")
      (item "Removes requests older than window (default: 60 seconds)")
      (item "Rejects if request count ≥ threshold (default: 10,000 requests/60s)")
      (item "**Trusted GUIDs:** Can bypass rate limiting (whitelist)")
      (para "**Default Configuration:**")
      (item "`max_requests`: 10,000")
      (item "`window_seconds`: 60.0")
      (item "`trusted_guids`: Empty set"))
    (subsection
      (heading "5. Replay Protection")
      (para "**Purpose:** Prevent replay attacks using captured packets")
      (para "**Algorithm:** Nonce cache with TTL")
      (para "**Implementation:**")
      (item "Tracks seen nonces: `Dict[nonce_bytes, timestamp]`")
      (item "**Nonce:** First 16 bytes of packet (HMAC value)")
      (item "**TTL:** 300 seconds (5 minutes, configurable)")
      (item "**Cleanup:** Automatic removal of expired nonces")
      (para "**Properties:**")
      (item "Returns `False` if nonce seen within TTL window (replay detected)")
      (item "Returns `True` if new nonce (allowed, then recorded)")
      (item "Memory bounded by TTL and packet rate"))
    (subsection
      (heading "6. Key Management")
      (para "**KeyStore:**")
      (item "**Default Key:** 32-byte shared symmetric key (all peers)")
      (item "**Per-Peer Keys:** Optional override for specific peers by GUID")
      (item "**Lookup:** GUID hex string → 32-byte key")
      (item "**Validation:** All keys must be exactly 32 bytes")))
  (section
    (heading "Message Processing Pipeline")
    (subsection
      (heading "Send Path")
      (para "**Protocol 0 (Text):**")
      (code "1. Encode message as UTF-8
2. Prepend protocol marker (0x00)
3. Build packet: Compute HMAC over GUID + Payload
4. Serialize: HMAC(16) + GUID(6) + Payload
5. Send via UDP socket")
      (para "**Protocol 1 (Binary):**")
      (code "1. Get next sequence number for channel: sequence = counter[channelID]++
2. IF protoOpts & 0x01: Compress FULL message with ZLIB
3. IF protoOpts & 0x02: Encrypt FULL message with AES-256-GCM
4. Chunk processed data into 1024-byte pieces (configurable)
5. FOR each chunk:
   a. Build 16-byte header (proto, protoOpts, channelID, sequence, chunkIndex, totalChunks)
   b. Payload = header + chunk_data
   c. Build packet: Compute HMAC over GUID + Payload
   d. Serialize: HMAC(16) + GUID(6) + Payload
   e. Send via UDP socket"))
    (subsection
      (heading "Receive Path")
      (para "**All Protocols:**")
      (code "1. Receive UDP datagram
2. Parse packet: Extract HMAC(16), GUID(6), Payload(remaining)
3. Validate minimum size (22 bytes)
4. Lookup key by GUID (or use default)
5. Recompute HMAC over GUID + Payload
6. Constant-time compare: Reject if HMAC mismatch
7. IF replay_protection enabled: Check nonce cache, reject if seen
8. IF rate_limiter enabled: Check sliding window, reject if over limit
9. Ignore self-packets (unless process_own_packets=True)
10. Route to protocol handler by first payload byte")
      (para "**Protocol 0 (Text) Handler:**")
      (code "1. Verify first byte is 0x00
2. Decode payload[1:] as UTF-8
3. Parse as JSON (or other text format)
4. Dispatch to application callback")
      (para "**Protocol 1 (Binary) Handler:**")
      (code "1. Parse header: Extract channelID, sequence, chunkIndex, totalChunks, protoOpts
2. Buffer key = (channelID, sequence)
3. Check deduplication cache (5-second window)
4. IF duplicate: Ignore
5. Store chunk in buffer: buffer[key][chunkIndex] = chunk_data
6. IF all chunks received (len(buffer[key]) == totalChunks):
   a. Pop buffer[key] immediately (prevents re-processing)
   b. Reassemble chunks in index order
   c. IF protoOpts & 0x02: Decrypt with AES-256-GCM (extract nonce from first 12 bytes)
   d. IF protoOpts & 0x01: Decompress with ZLIB
   e. Parse result (typically JSON-RPC)
   f. Dispatch to application callback")
      (para "**Message Reassembly:**")
      (item "Buffer: `Dict[(channelID, sequence), BufferEntry]`")
      (item "BufferEntry: `{chunks: Dict[index, bytes], total_chunks: int, created_at: float}`")
      (item "Timeout: 60 seconds for incomplete buffers (auto-cleanup)")
      (item "Deduplication: Track processed `(channelID, sequence)` for 5 seconds")))
  (section
    (heading "Transport Layer")
    (subsection
      (heading "UDP Socket Configuration")
      (para "**Binding:**")
      (item "Address: `0.0.0.0:port` (all interfaces)")
      (item "Default port: 50000")
      (item "Protocol: UDP (SOCK_DGRAM)")
      (para "**Socket Options:**")
      (item "`SO_REUSEADDR` - Allow immediate rebind after restart")
      (item "`SO_REUSEPORT` - Multiple processes on same IP:port (macOS/Linux)")
      (item "`SO_BROADCAST` - Enable UDP broadcast transmission")
      (para "**Broadcast Target:**")
      (item "Address: `255.255.255.255:50000`")
      (item "All packets sent via broadcast (no unicast)")
      (item "Services filter by method name, request ID, or target service ID"))
    (subsection
      (heading "Asyncio Integration (Python)")
      (para "**UDPTransport:**")
      (item "Uses `asyncio.DatagramProtocol` for async packet handling")
      (item "Creates new task for each received packet (non-blocking)")
      (item "Supports graceful shutdown (closes socket, cancels tasks)")
      (para "**Packet Handling:**")
      (code "async def _handle_packet(self, data: bytes, addr: tuple):
    # 1. Parse packet
    # 2. Validate HMAC
    # 3. Check replay protection
    # 4. Check rate limits
    # 5. Invoke callback with (guid, payload, addr)"))
    (subsection
      (heading "Protocol Router")
      (para "**Routing Logic:**")
      (code "async def route(self, payload: bytes):
    if not payload:
        return

    protocol_id = payload[0]

    if protocol_id == 0x00:
        await text_protocol_handler(payload)
    elif protocol_id == 0x01:
        await binary_protocol_handler(payload)
    else:
        log_error(f\"Unknown protocol ID: {protocol_id:02x}\")")))
  (section
    (heading "Key Design Principles")
    (subsection
      (heading "1. Payload Agnostic")
      (para "YX doesn't care what you send. The protocol layer handles:")
      (item "Integrity (HMAC)")
      (item "Confidentiality (AES-GCM, optional)")
      (item "Compression (ZLIB, optional)")
      (item "Chunking (for large messages)")
      (para "Application layer decides payload format (JSON, Protobuf, MessagePack, raw binary, etc.)"))
    (subsection
      (heading "2. Broadcast-First Architecture")
      (item "All communication via UDP broadcast (`255.255.255.255`)")
      (item "No unicast delivery (kernel `SO_REUSEPORT` causes non-deterministic routing)")
      (item "Receivers filter messages by:")
      (item "Method name")
      (item "Request ID")
      (item "Target service ID")
      (item "Channel ID"))
    (subsection
      (heading "3. Encrypt-Then-Chunk")
      (para "**Security Best Practice:**")
      (item "Compress FULL message")
      (item "Encrypt FULL compressed message")
      (item "Then chunk encrypted result")
      (para "**Reason:** Prevents cryptographic attacks on partial data"))
    (subsection
      (heading "4. Channel Isolation")
      (item "65,536 logical channels (16-bit `channelID`)")
      (item "Each channel has independent 4B sequence space")
      (item "Use cases:")
      (item "Per-service channels")
      (item "Per-topic channels")
      (item "Priority lanes"))
    (subsection
      (heading "5. Cross-Platform Wire Format")
      (item "Python and Swift implementations have 100% wire-format parity")
      (item "Identical byte layout for all protocol versions")
      (item "Struct packing: Big-endian (`>`) for all multi-byte integers")))
  (section
    (heading "Implementation Files (Python)")
    (subsection
      (heading "Core Transport")
      (item "`yx/transport/packet.py` - Packet dataclass")
      (item "`yx/transport/packet_builder.py` - Build/parse/validate packets")
      (item "`yx/transport/udp_transport.py` - Socket + asyncio integration")
      (item "`yx/transport/protocol_router.py` - Protocol routing by first byte"))
    (subsection
      (heading "Protocols")
      (item "`yx/transport/text_protocol.py` - Protocol 0 handler")
      (item "`yx/transport/binary_protocol.py` - Protocol 1 handler (v2.0)"))
    (subsection
      (heading "Security")
      (item "`yx/primitives/data_crypto.py` - HMAC-SHA256, AES-256-GCM")
      (item "`yx/primitives/data_compression.py` - ZLIB compression")
      (item "`yx/transport/key_store.py` - Key management")
      (item "`yx/transport/rate_limiter.py` - Rate limiting")
      (item "`yx/transport/replay_protection.py` - Replay protection"))
    (subsection
      (heading "Utilities")
      (item "`yx/primitives/data_chunking.py` - Chunking logic")
      (item "`yx/primitives/guid_factory.py` - GUID generation"))
    (subsection
      (heading "Application")
      (item "`yx/application/yx_coordinator.py` - Composition root")
      (item "`yx/application/configuration.py` - Configuration dataclass")
      (item "`yx/YX.py` - High-level facade API")))
  (section
    (heading "Reference Documentation")
    (para "**Full Protocol Spec:**")
    (item "`../sdts/docs/udp-packet-format.md` (719 lines) - Complete specification with version history")
    (para "**Implementation Reference:**")
    (item "`../sdts/src/python/yx/` - Python implementation (v1.0.3)")
    (item "`../sdts/src/swift/yx/` - Swift implementation (wire-format parity)"))
  (section
    (heading "Version History")
    (para "**v1.0.3 (Current)**")
    (item "Binary Protocol v2.0 with `(channelID, sequence)` tuple")
    (item "Python and Swift wire-format parity")
    (item "Production-ready stability")
    (para "**v1.0.0**")
    (item "Binary Protocol v1.0 with `msgID` (1 byte)")
    (item "Initial release"))
  (section
    (heading "Technical Notes")
    (item "1. **HMAC Truncation:** 128 bits provides adequate security for packet integrity")
    (item "2. **Chunk Size:** Default 1024 bytes balances MTU efficiency and reassembly overhead")
    (item "3. **Nonce Reuse:** Each AES-GCM encryption uses fresh random nonce (critical for security)")
    (item "4. **Deduplication:** 5-second window prevents duplicate processing of retransmitted packets")
    (item "5. **Thread Safety:** Python implementation uses asyncio (not thread-safe for multi-threaded use)")
    (item "6. **MTU Awareness:** 1024-byte chunks + 22-byte YX header + 16-byte Binary header = ~1062 bytes (under 1500 MTU)")
    (item "7. **No TLS Required:** HMAC + AES-GCM provides end-to-end security without TLS overhead")))
