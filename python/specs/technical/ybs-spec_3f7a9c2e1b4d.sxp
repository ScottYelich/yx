(doc
  (title "Specification: Python Implementation Design")
  (source-format markdown)
  (converted "2026-07-19")
  (para "name: Python Implementation Design description: Python-specific module structure, dependency choices, asyncio model, and design decisions for the YX protocol implementation type: technical guid: 3f7a9c2e1b4d version: 0.1.0 status: Implemented last_updated: 2026-04-11")
  (kv "GUID" "`3f7a9c2e1b4d`")
  (kv "Version" "0.1.0")
  (kv "Status" "Implemented")
  (kv "Last Updated" "2026-04-11")
  (section
    (heading "Overview")
    (para "This spec captures design decisions specific to the Python implementation of the YX protocol. It records the *why* behind Python-specific choices so that implementers understand what is intentional vs. incidental.")
    (para "The protocol requirements are in `../../../protocol/specs/`. This spec only covers what is Python-specific."))
  (section
    (heading "Goals and Non-Goals")
    (subsection
      (heading "Goals")
      (item "Document the dependency selection rationale")
      (item "Record the asyncio design model")
      (item "Define the module and package structure")
      (item "Specify Python version constraints"))
    (subsection
      (heading "Non-Goals")
      (item "Does not define the wire format (see `protocol/specs/technical/yx-protocol-spec.sxp`)")
      (item "Does not define test coverage requirements (see `python/specs/testing/`)")
      (item "Does not prescribe Swift, Rust, or other implementations")))
  (section
    (heading "Dependencies")
    (subsection
      (heading "Required")
      (item "`cryptography` ≥41.0.0 — HMAC-SHA256, AES-256-GCM")
      (item "`pytest` ≥7.4.0 — test framework")
      (item "`pytest-asyncio` ≥0.21.0 — async test support")
      (item "`pytest-cov` ≥4.1.0 — coverage reporting"))
    (subsection
      (heading "Why `cryptography` and not alternatives")
      (table
        (row "Option" "Rejected Reason")
        (row "`hashlib` (stdlib)" "No constant-time HMAC comparison")
        (row "`PyCryptodome`" "Requires compile, less pythonic API")
        (row "`pyca/cryptography` (chosen)" "OpenSSL-backed, constant-time, well-audited, pip-installable"))))
  (section
    (heading "Requirements")
    (subsection
      (heading "Functional Requirements")
      (kv "FR-1" "Module Structure")
      (kv "Description" "Source code must live in `src/yx/primitives/` and `src/yx/transport/`")
      (kv "Priority" "High")
      (item "**Acceptance Criteria**:")
      (item "[ ] `src/yx/primitives/` contains pure computation modules (no I/O)")
      (item "[ ] `src/yx/transport/` contains packet handling and socket I/O")
      (item "[ ] No circular imports between `primitives` and `transport`")
      (kv "FR-2" "Async UDP Model")
      (kv "Description" "UDP send and receive operations use `asyncio`")
      (kv "Priority" "High")
      (item "**Acceptance Criteria**:")
      (item "[ ] `UDPSocket` exposes `async def send_packet(...)` and `async def receive_packet(...)`")
      (item "[ ] No blocking socket calls on the event loop thread")
      (item "[ ] `asyncio.get_event_loop().run_in_executor()` used for blocking ops if needed")
      (kv "FR-3" "Dataclass-Based Packet")
      (kv "Description" "The `Packet` type is a Python `dataclass`")
      (kv "Priority" "Medium")
      (item "**Acceptance Criteria**:")
      (item "[ ] `@dataclass` decorator applied to `Packet`")
      (item "[ ] `hmac: bytes`, `guid: bytes`, `payload: bytes` fields")
      (item "[ ] `__post_init__` validates field lengths")
      (kv "FR-4" "Constant-Time HMAC Comparison")
      (kv "Description" "HMAC verification uses constant-time comparison")
      (kv "Priority" "Critical")
      (item "**Acceptance Criteria**:")
      (item "[ ] `hmac.compare_digest()` (or `cryptography` equivalent) used for all HMAC comparisons")
      (item "[ ] Standard `==` never used to compare HMAC values"))
    (subsection
      (heading "Non-Functional Requirements")
      (kv "NFR-1" "Python Version")
      (kv "Description" "Implementation runs on Python 3.10+")
      (kv "Metric" "`python --version`")
      (kv "Target" "3.10 ≤ version")
      (kv "NFR-2" "Zero Native Extensions")
      (kv "Description" "All dependencies install via pip without compilation")
      (kv "Metric" "`pip install -e .[dev]` succeeds on a clean machine")
      (kv "Target" "No build errors on macOS, Linux, Windows")
      (kv "NFR-3" "Import Performance")
      (kv "Description" "`import yx` completes quickly")
      (kv "Metric" "Time to `import yx`")
      (kv "Target" "<100ms")))
  (section
    (heading "Architecture")
    (subsection
      (heading "Module Dependency Graph")
      (code "tests/
├── unit/
└── integration/
    
src/yx/
├── __init__.py
├── primitives/
│   ├── __init__.py
│   ├── guid_factory.py     # GUIDFactory — no external deps
│   └── data_crypto.py      # DataCrypto — depends on `cryptography`
└── transport/
    ├── __init__.py
    ├── packet.py           # Packet dataclass — no external deps
    ├── packet_builder.py   # PacketBuilder — depends on primitives
    └── udp_socket.py       # UDPSocket — depends on asyncio, packet_builder"))
    (subsection
      (heading "Data Flow")
      (item "1. `GUIDFactory.generate()` → 6-byte `bytes`")
      (item "2. `DataCrypto.compute_hmac(key, guid, payload)` → 16-byte `bytes`")
      (item "3. `Packet(hmac, guid, payload)` → dataclass instance")
      (item "4. `PacketBuilder.serialize(packet)` → raw `bytes`")
      (item "5. `UDPSocket.send_packet(...)` → UDP datagram sent")
      (item "6. `UDPSocket.receive_packet(...)` → raw `bytes` received")
      (item "7. `PacketBuilder.parse_and_validate(raw, key)` → `Packet` or raises")))
  (section
    (heading "Traceability")
    (para "**Implements**:")
    (item "`protocol/specs/technical/yx-protocol-spec.sxp` (full protocol)")
    (item "`protocol/specs/architecture/ybs-decisions.sxp` D05 (Python as reference)"))
  (section
    (heading "Version History")
    (subsection
      (heading "0.1.0 (2026-04-11)")
      (item "Initial spec creation, documenting existing implementation decisions"))))
