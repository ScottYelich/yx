(doc
  (title "Testing Specifications — Python System-Wide Defaults")
  (source-format markdown)
  (converted "2026-07-19")
  (kv "System" "YX Python Implementation")
  (kv "Category" "Testing")
  (kv "Type" "BASE")
  (kv "Version" "0.1.0")
  (kv "Last Updated" "2026-04-11")
  (section
    (heading "Test Framework")
    (kv "Framework" "`pytest` (≥7.4.0)")
    (kv "Async support" "`pytest-asyncio` (≥0.21.0), `asyncio_mode = \"auto\"`")
    (kv "Coverage" "`pytest-cov` (≥4.1.0)"))
  (section
    (heading "Test Organization")
    (code "tests/
├── unit/           # One file per source module: test_<module>.py
└── integration/    # End-to-end flows: test_<feature>_flow.py"))
  (section
    (heading "Running Tests")
    (code "pytest                                    # All tests
pytest tests/unit/                        # Unit only
pytest tests/integration/                 # Integration only
pytest --cov=src --cov-report=term-missing  # With coverage"))
  (section
    (heading "Coverage Thresholds")
    (para "Per the protocol testing BASE spec: overall ≥80%, critical paths 100%. Coverage is checked as part of the final verification step."))
  (section
    (heading "Async Test Pattern")
    (code "import pytest

@pytest.mark.asyncio
async def test_send_receive():
    ...")
    (para "With `asyncio_mode = \"auto\"` in `pyproject.toml`, the decorator is optional but recommended for clarity."))
  (section
    (heading "Deterministic Time in Tests")
    (para "For replay protection and rate limiting tests, patch `time.time()`:")
    (code "from unittest.mock import patch

with patch('yx.security.time.time', return_value=1000.0):
    ...")))
