(doc
  (title "Specification: Python Testing Strategy")
  (source-format markdown)
  (converted "2026-07-19")
  (para "name: Python Testing Strategy description: pytest setup, async testing patterns, coverage targets, and canonical artifact generation for the Python YX implementation type: testing guid: 8b2d5e9f1a3c version: 0.1.0 status: Implemented last_updated: 2026-04-11")
  (kv "GUID" "`8b2d5e9f1a3c`")
  (kv "Version" "0.1.0")
  (kv "Status" "Implemented")
  (kv "Last Updated" "2026-04-11")
  (section
    (heading "Overview")
    (para "Defines the testing approach for the Python YX implementation. Covers framework configuration, test organization, coverage requirements, and canonical artifact generation. Protocol-level testing requirements (coverage thresholds, interop matrix) come from `protocol/specs/testing/`; this spec adds Python-specific detail."))
  (section
    (heading "Goals and Non-Goals")
    (subsection
      (heading "Goals")
      (item "Define pytest configuration and plugin usage")
      (item "Specify how async UDP tests are structured")
      (item "Define the canonical artifact generation process")
      (item "Specify coverage reporting and thresholds"))
    (subsection
      (heading "Non-Goals")
      (item "Does not define test coverage thresholds (inherited from `protocol/specs/testing/_BASE.sxp`)")
      (item "Does not define the interop test matrix (see `protocol/specs/testing/interoperability-requirements.sxp`)")))
  (section
    (heading "Requirements")
    (subsection
      (heading "Functional Requirements")
      (kv "FR-1" "pytest Configuration")
      (kv "Description" "pytest is configured via `pyproject.toml`, not `pytest.ini` or `setup.cfg`")
      (kv "Priority" "High")
      (item "**Acceptance Criteria**:")
      (item "[ ] `[tool.pytest.ini_options]` section in `pyproject.toml`")
      (item "[ ] `testpaths = [\"tests\"]`")
      (item "[ ] `asyncio_mode = \"auto\"`")
      (item "[ ] `python_files`, `python_classes`, `python_functions` patterns defined")
      (kv "FR-2" "Coverage Configuration")
      (kv "Description" "Coverage reports exclude non-testable lines")
      (kv "Priority" "Medium")
      (item "**Acceptance Criteria**:")
      (item "[ ] `[tool.coverage.run]` configured with `source = [\"src\"]`")
      (item "[ ] `[tool.coverage.report]` excludes `__repr__`, `raise NotImplementedError`, etc.")
      (item "[ ] `pytest --cov=src --cov-report=term-missing` produces a clean report")
      (kv "FR-3" "Canonical Artifact Generation")
      (kv "Description" "A test/script generates canonical JSON test vectors")
      (kv "Priority" "Critical")
      (item "**Acceptance Criteria**:")
      (item "[ ] `tests/generate_canonical.py` script exists")
      (item "[ ] Running it produces `canonical/test-vectors/` JSON files")
      (item "[ ] Each test vector has: `name`, `guid`, `key`, `payload_hex`, `expected_hmac`, `expected_packet_hex`")
      (item "[ ] Generated vectors pass validation by a separate read-and-verify script")
      (kv "FR-4" "Security Test Coverage")
      (kv "Description" "Security-critical paths have dedicated test cases")
      (kv "Priority" "Critical")
      (item "**Acceptance Criteria**:")
      (item "[ ] Timing attack test: verifies HMAC comparison takes constant time (or uses `compare_digest`)")
      (item "[ ] Avalanche test: one-bit change in key/payload produces different HMAC")
      (item "[ ] Replay test: duplicate GUID within TTL window is rejected")
      (item "[ ] Rate limit test: sender exceeding limit is rejected"))
    (subsection
      (heading "Non-Functional Requirements")
      (kv "NFR-1" "Test Speed")
      (kv "Description" "Full test suite runs quickly")
      (kv "Metric" "Wall-clock time for `pytest`")
      (kv "Target" "<30 seconds on developer hardware")
      (kv "NFR-2" "No Test Dependencies on External Services")
      (kv "Description" "All tests run offline with no network dependency except integration tests that bind to loopback")
      (kv "Metric" "`pytest tests/unit/` succeeds with no network")))
  (section
    (heading "Traceability")
    (para "**Implements**:")
    (item "`protocol/specs/testing/testing-strategy.sxp` (Python test patterns)")
    (item "`protocol/specs/testing/interoperability-requirements.sxp` (interop test setup)"))
  (section
    (heading "Version History")
    (subsection
      (heading "0.1.0 (2026-04-11)")
      (item "Initial spec creation"))))
