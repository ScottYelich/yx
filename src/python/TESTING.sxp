(doc
  (title "YX Framework - Testing Guide")
  (source-format markdown)
  (converted "2026-07-19")
  (section
    (heading "Setup")
    (subsection
      (heading "Install Dependencies")
      (para "The YX framework requires the `cryptography` library. It's already installed in the `yx-dev` pyenv environment."))
    (subsection
      (heading "Python Environment")
      (para "This project uses **pyenv** for Python environment management. The `yx-dev` environment has all dependencies installed.")))
  (section
    (heading "Quick Start")
    (subsection
      (heading "Option 1: Use Full Path (Always Works)")
      (code "# Run CLI
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9999

# Run tests
~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py two-peer"))
    (subsection
      (heading "Option 2: Configure pyenv in Shell (Recommended)")
      (para "Add to your `~/.zshrc` (or `~/.bashrc` for bash):")
      (code "eval \"$(pyenv init -)\"
eval \"$(pyenv virtualenv-init -)\"")
      (para "Then restart your shell or run:")
      (code "source ~/.zshrc")
      (para "Now when you're in the `src/python` directory, pyenv will automatically use the `yx-dev` environment (thanks to `.python-version` file).")
      (para "You can then use just `python`:")
      (code "python -m yxCLI --port 9999
python scripts/test-p2p.py two-peer")))
  (section
    (heading "Running Tests")
    (subsection
      (heading "Automated P2P Tests")
      (para "The `scripts/test-p2p.py` script runs automated multi-instance tests:")
      (code "# Two-peer communication test
~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py two-peer

# Test all 4 protocol variants (0x00-0x03)
~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py proto-opts

# Three-peer mesh network test
~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py three-mesh")
      (para "Logs are saved to `p2p-test-logs/` directory."))
    (subsection
      (heading "Manual Multi-Instance Testing")
      (para "**Terminal 1 (Hub on port 9999):**")
      (code "~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9999")
      (para "**Terminal 2 (Sender on port 9998):**")
      (code "~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9998 --peers localhost:9999 --shutdown-after 10")
      (para "**Terminal 3 (Binary protocol test with compression + encryption):**")
      (code "~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9997 --peers localhost:9999 --proto-opts 0x03 --shutdown-after 10"))
    (subsection
      (heading "Unit Tests")
      (para "Run pytest unit tests:")
      (code "# All tests
~/.pyenv/versions/yx-dev/bin/python -m pytest tests/ -v

# Just primitives tests
~/.pyenv/versions/yx-dev/bin/python -m pytest tests/test_primitives/ -v

# Specific test file
~/.pyenv/versions/yx-dev/bin/python -m pytest tests/test_primitives/test_guid.py -v")))
  (section
    (heading "CLI Usage")
    (subsection
      (heading "Basic Command")
      (code "~/.pyenv/versions/yx-dev/bin/python -m yxCLI [options]"))
    (subsection
      (heading "Options")
      (item "`--port PORT` - UDP listen port (default: 9999)")
      (item "`--peers HOST:PORT,...` - Comma-separated list of peers to send packets to")
      (item "`--proto-opts 0xNN` - Binary protocol options (0x00-0x03):")
      (item "`0x00` = Plaintext, Uncompressed")
      (item "`0x01` = Plaintext, Compressed")
      (item "`0x02` = Encrypted, Uncompressed")
      (item "`0x03` = Encrypted, Compressed")
      (item "`--shutdown-after N` - Auto-shutdown after N seconds")
      (item "`--key HEXKEY` - 64 hex char shared key (default: test key)"))
    (subsection
      (heading "Examples")
      (code "# Listen on port 9999 (default shared key)
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9999

# Send to peer on 9999
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9998 --peers localhost:9999

# Test binary protocol with encryption + compression
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9998 --peers localhost:9999 --proto-opts 0x03

# Auto-shutdown after 10 seconds
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9998 --peers localhost:9999 --shutdown-after 10

# Multiple peers
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9997 --peers localhost:9999,localhost:9998

# Custom shared key
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9999 --key D3046ECC8DD3242ADF62801A33EF1004003B01B4C8F558DF72E637DA30321CCD")))
  (section
    (heading "Shared Key")
    (para "All instances must use the **same shared key** for HMAC validation to work.")
    (para "**Default shared key** (used automatically):")
    (code "D3046ECC8DD3242ADF62801A33EF1004003B01B4C8F558DF72E637DA30321CCD")
    (para "This matches the Swift test key for cross-platform compatibility.")
    (para "To use a custom key, provide the same `--key` argument to all instances:")
    (code "# Hub
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9999 --key YOUR_64_HEX_CHARS

# Sender (must use same key)
~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9998 --peers localhost:9999 --key YOUR_64_HEX_CHARS"))
  (section
    (heading "Verification Tests")
    (subsection
      (heading "HMAC Verification")
      (code "# Standalone HMAC test (no dependencies)
python3 verify_hmac_standalone.py

# Full framework HMAC test (requires cryptography)
~/.pyenv/versions/yx-dev/bin/python verify_hmac.py")
      (para "Both tests should show all tests passing with ✅ checkmarks.")))
  (section
    (heading "Troubleshooting")
    (subsection
      (heading "\"ModuleNotFoundError: No module named 'cryptography'\"")
      (para "You're using system Python instead of the pyenv environment. Use:")
      (code "~/.pyenv/versions/yx-dev/bin/python")
      (para "Or set up pyenv in your shell (see Setup section above)."))
    (subsection
      (heading "\"HMAC validation failed\"")
      (para "Instances are using different keys. Make sure all instances either:")
      (item "1. Use the default shared key (no `--key` argument), OR")
      (item "2. Use the same custom `--key` value"))
    (subsection
      (heading "\"can't find '__main__' module\"")
      (para "You're trying to run a directory instead of a Python module/script.")
      (para "**Wrong:**")
      (code "python p2p-test-logs  # This is a directory!")
      (para "**Right:**")
      (code "python scripts/test-p2p.py
python -m yxCLI")))
  (section
    (heading "Test Scenarios")
    (subsection
      (heading "Scenario 1: Two-Peer Communication")
      (para "Tests basic P2P communication between two instances.")
      (code "~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py two-peer"))
    (subsection
      (heading "Scenario 2: Protocol Options Test")
      (para "Tests all 4 binary protocol variants in parallel.")
      (code "~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py proto-opts")
      (para "Creates logs:")
      (item "`p2p-test-logs/hub.log` - Hub receiving packets")
      (item "`p2p-test-logs/sender-0x00.log` - Plaintext, Uncompressed")
      (item "`p2p-test-logs/sender-0x01.log` - Plaintext, Compressed")
      (item "`p2p-test-logs/sender-0x02.log` - Encrypted, Uncompressed")
      (item "`p2p-test-logs/sender-0x03.log` - Encrypted, Compressed"))
    (subsection
      (heading "Scenario 3: Three-Peer Mesh")
      (para "Tests full mesh network with 3 peers all communicating.")
      (code "~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py three-mesh")))
  (section
    (heading "Expected Output")
    (subsection
      (heading "Successful Test")
      (code "ℹ️ [06:16:24.057] Using default shared test key
ℹ️ [06:16:24.057] Registered RPC handler: task.hello
🧩 [06:16:24.057] GUID: 1697FBC25676
🔐 [06:16:24.057] Key: D3046ECC8DD3242ADF62801A33EF1004...
🔧 [06:16:24.057] Running yxCLI
🌐 [06:16:24.057] UDP listening on port 9999
✅ [06:16:24.057] YX Coordinator started
ℹ️ [06:16:25.089] Received text message: {'method': 'task.hello', ...}"))
    (subsection
      (heading "Failed HMAC (wrong key)")
      (code "❌ [06:07:51.874] HMAC validation failed from C393C94E2AC8")
      (para "This means the sender used a different key than the receiver.")))
  (section
    (heading "Cross-Platform Testing")
    (para "The Python implementation is **100% wire-compatible** with the Swift version.")
    (para "You can run:")
    (item "**Swift hub + Python sender** ✅")
    (item "**Python hub + Swift sender** ✅")
    (item "**Mixed mesh network** ✅")
    (para "Just ensure all instances (Swift and Python) use the same shared key."))
  (section
    (heading "Quick Reference")
    (table
      (row "Task" "Command")
      (row "Run hub" "`~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9999`")
      (row "Run sender" "`~/.pyenv/versions/yx-dev/bin/python -m yxCLI --port 9998 --peers localhost:9999`")
      (row "Two-peer test" "`~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py two-peer`")
      (row "Protocol test" "`~/.pyenv/versions/yx-dev/bin/python scripts/test-p2p.py proto-opts`")
      (row "Unit tests" "`~/.pyenv/versions/yx-dev/bin/python -m pytest tests/ -v`")
      (row "HMAC verify" "`~/.pyenv/versions/yx-dev/bin/python verify_hmac.py`")
      (row "Check logs" "`cat p2p-test-logs/*.log`")))
  (section
    (heading "Installation Reminder")
    (para "If you need to reinstall dependencies:")
    (code "# Install cryptography in pyenv environment
~/.pyenv/versions/yx-dev/bin/pip install cryptography

# Or install all requirements
~/.pyenv/versions/yx-dev/bin/pip install -r requirements.txt")))
