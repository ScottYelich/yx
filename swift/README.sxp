(doc
  (title "YX Protocol — Swift Implementation")
  (source-format markdown)
  (converted "2026-07-19")
  (kv "Status" "✅ Complete (`canonical/swift/`)")
  (kv "Protocol spec" "[`../protocol/specs/`](../protocol/specs/)")
  (section
    (heading "What This Is")
    (para "The Swift implementation of the YX protocol. It validates against canonical test vectors generated by the Python reference implementation, proving cross-language wire-format compatibility."))
  (section
    (heading "Structure")
    (code "swift/
├── specs/                    # Swift-specific implementation specs
│   ├── technical/
│   │   ├── _BASE.sxp          # Swift coding standards
│   │   └── ybs-spec_6c4f2a8d1e7b.sxp  # Module design & CryptoKit decisions
│   └── testing/
│       ├── _BASE.sxp          # XCTest standards
│       └── ybs-spec_9e1b3c6a4f2d.sxp  # Swift testing strategy
└── steps/                    # YBS build steps
    ├── STEPS_ORDER.txt
    ├── ybs-step_000000000000.sxp    # Step 0: Swift build configuration
    └── ybs-step_<guid>.md         # Steps 1-15"))
  (section
    (heading "Build Instructions")
    (item "1. Ensure Python implementation is complete and `canonical/test-vectors/` exists")
    (item "2. Start at the `yx/` project root")
    (item "3. Execute Step 0: `swift/steps/ybs-step_000000000000.sxp`")
    (item "4. Follow the step sequence in `swift/steps/STEPS_ORDER.txt`")
    (item "5. Build output lands in `builds/<build_name>/`"))
  (section
    (heading "Canonical Reference")
    (para "The completed reference implementation lives in `canonical/swift/`."))
  (section
    (heading "Key Design Decisions")
    (para "See `specs/technical/ybs-spec_6c4f2a8d1e7b.sxp` for Swift-specific choices. See `../protocol/specs/architecture/ybs-decisions.sxp` for protocol-level ADRs.")))
