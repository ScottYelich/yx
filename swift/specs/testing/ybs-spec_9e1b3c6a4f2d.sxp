(doc
  (title "Specification: Swift Testing Strategy")
  (source-format markdown)
  (converted "2026-07-19")
  (para "name: Swift Testing Strategy description: XCTest setup, async test patterns, coverage configuration, and canonical validation for the Swift YX implementation type: testing guid: 9e1b3c6a4f2d version: 0.1.0 status: Implemented last_updated: 2026-04-11")
  (kv "GUID" "`9e1b3c6a4f2d`")
  (kv "Version" "0.1.0")
  (kv "Status" "Implemented")
  (kv "Last Updated" "2026-04-11")
  (section
    (heading "Overview")
    (para "Defines the testing approach for the Swift YX implementation. Covers XCTest configuration, async test patterns, canonical validation, and coverage reporting. Protocol-level requirements come from `protocol/specs/testing/`."))
  (section
    (heading "Goals and Non-Goals")
    (subsection
      (heading "Goals")
      (item "Define XCTest configuration for async UDP tests")
      (item "Specify canonical validation test structure")
      (item "Define coverage reporting commands")
      (item "Specify clock injection pattern for deterministic tests"))
    (subsection
      (heading "Non-Goals")
      (item "Does not define coverage thresholds (inherited from `protocol/specs/testing/_BASE.sxp`)")
      (item "Does not define the interop test matrix")))
  (section
    (heading "Requirements")
    (subsection
      (heading "Functional Requirements")
      (kv "FR-1" "XCTest Target Configuration")
      (kv "Description" "Test target is declared in `Package.swift` as a `.testTarget`")
      (kv "Priority" "High")
      (item "**Acceptance Criteria**:")
      (item "[ ] `YXProtocolTests` test target declares dependency on `YXProtocol`")
      (item "[ ] `swift test` discovers and runs all test cases")
      (item "[ ] Test file naming: `<TypeName>Tests.swift`")
      (kv "FR-2" "Async Test Support")
      (kv "Description" "Tests of async functions use `async throws` test methods")
      (kv "Priority" "High")
      (item "**Acceptance Criteria**:")
      (item "[ ] All UDP tests are `async throws` XCTestCase methods")
      (item "[ ] No `XCTestExpectation` used for async operations (use `async/await` instead)")
      (kv "FR-3" "Canonical Validation Tests")
      (kv "Description" "A test suite validates Swift output against Python canonical test vectors")
      (kv "Priority" "Critical")
      (item "**Acceptance Criteria**:")
      (item "[ ] `CanonicalValidationTests.swift` in `Tests/YXProtocolTests/Integration/`")
      (item "[ ] Loads `canonical/test-vectors/*.json` relative to package root")
      (item "[ ] For each test vector: computes HMAC, serializes packet, compares bytes")
      (item "[ ] All canonical test vectors pass")
      (kv "FR-4" "Security Test Coverage")
      (kv "Description" "Security-critical paths have dedicated test cases")
      (kv "Priority" "Critical")
      (item "**Acceptance Criteria**:")
      (item "[ ] Timing: HMAC comparison uses `isValidAuthenticationCode` (constant-time)")
      (item "[ ] Replay: duplicate GUID within TTL window is rejected")
      (item "[ ] Rate limit: sender exceeding limit is rejected")
      (item "[ ] Tamper: HMAC mismatch throws error")
      (kv "FR-5" "Deterministic Clock for Security Tests")
      (kv "Description" "Replay and rate limit tests use injected mock clock")
      (kv "Priority" "High")
      (item "**Acceptance Criteria**:")
      (item "[ ] `Clock` protocol defined: `var now: TimeInterval { get }`")
      (item "[ ] `SystemClock` uses `Date().timeIntervalSince1970`")
      (item "[ ] `MockClock` used in all time-sensitive tests")
      (item "[ ] No calls to `Date()` directly in `ReplayWindow` or `RateLimiter`"))
    (subsection
      (heading "Non-Functional Requirements")
      (kv "NFR-1" "Test Execution Speed")
      (kv "Description" "Full Swift test suite runs quickly")
      (kv "Metric" "`swift test` wall-clock time")
      (kv "Target" "<60 seconds on Apple Silicon")
      (kv "NFR-2" "Test Isolation")
      (kv "Description" "Tests do not share state between test cases")
      (kv "Metric" "Tests pass in any order")
      (kv "Target" "All tests pass when run individually and in a suite")))
  (section
    (heading "Traceability")
    (para "**Implements**:")
    (item "`protocol/specs/testing/testing-strategy.sxp`")
    (item "`protocol/specs/testing/interoperability-requirements.sxp`"))
  (section
    (heading "Version History")
    (subsection
      (heading "0.1.0 (2026-04-11)")
      (item "Initial spec creation"))))
