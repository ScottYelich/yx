  (kv "Version" "0.1.0")
  (section
    (heading "Overview")
    (para "Create end-to-end integration tests for Swift implementation."))
  (section
    (heading "What This Step Builds")
    (para "Builds end-to-end integration tests verifying the complete packet flow with real UDP loopback sockets: `build → serialize → send → receive → parse → validate`."))
  (section
    (heading "Step Objectives")
    (item "1. Test complete packet flow")
    (item "2. Test send/receive (when async supported)")
    (item "3. Integration test coverage"))
  (section
